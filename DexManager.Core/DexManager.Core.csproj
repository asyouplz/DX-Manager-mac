<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DexManager</RootNamespace>
    <AssemblyName>DexManager.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Use the same protocol, bundle hash and owned process lifecycle on both hosts. -->
    <Compile Include="../DexManager/Services/LoopbackDexService.cs" Link="Services/LoopbackDexService.cs" />
    <Compile Include="../DexManager/Services/LoopbackDexProtocol.cs" Link="Services/LoopbackDexProtocol.cs" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DexManager.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DexManager.MultiDeviceTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
