<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DexManager.Mac</RootNamespace>
    <AssemblyName>DXManager.Mac</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>2.0.1</Version>
    <InformationalVersion>2.0.1-phone-preview</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <CopyBundledMacTools Condition="'$(CopyBundledMacTools)' == ''">true</CopyBundledMacTools>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DexManager.Core\DexManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\tools\**\*.*" Exclude="..\tools\loopback\**\*" Condition="'$(CopyBundledMacTools)' == 'true'">
      <Link>tools\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- Architecture-independent helper is also needed when publishing without developer tools. -->
    <None Include="..\tools\loopback\*">
      <Link>tools\loopback\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DexManager.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
